+"""Ordered TCP video receiver and latest-decoded-frame queue helpers.
+
+Encoded H.264 bytes must never be discarded to reduce latency. TCP backpressure
+bounds memory while preserving decoder continuity. Only decoded frames may be
+replaced safely. This receiver replaces the SDK's one video socket before start;
+it creates neither an additional camera stream nor a second robot client.
+"""
+import queue
+import socket
+import threading
+import time
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class VideoChunk:
+    data: bytes
+    stamp_ns: int
+    received_at: float
+
+
+class LosslessVideoConnection:
+    def __init__(self, clock_ns=time.time_ns, capacity=32, receive_bytes=32768):
+        self._sock_queue = queue.Queue(maxsize=capacity)
+        self._sock = None
+        self._sock_recv = None
+        self._receiving = False
+        self._closed = False
+        self.clock_ns = clock_ns
+        self.receive_bytes = receive_bytes
+        self.chunks = self.bytes = self.queue_waits = self.socket_timeouts = 0
+        self.last_receive_at = None
+        self.max_receive_gap_s = 0.
+        self.error = ''
+
+    def connect(self, addr, ip_proto='tcp'):
+        if ip_proto != 'tcp':
+            self.error = 'Lossless video receiver requires TCP'
+            return False
+        self._closed = False
+        self.error = ''
+        self.last_receive_at = None
+        self.max_receive_gap_s = 0.
+        self.chunks = self.bytes = self.queue_waits = self.socket_timeouts = 0
+        while True:
+            try:
+                self._sock_queue.get_nowait()
+            except queue.Empty:
+                break
+        try:
+            self._sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
+            self._sock.settimeout(3.)
+            self._sock.connect(addr)
+            self._sock.settimeout(.2)
+        except OSError as exc:
+            self.error = str(exc)
+            if self._sock is not None:
+                self._sock.close()
+            return False
+        self._receiving = True
+        self._sock_recv = threading.Thread(target=self._recv_task, daemon=True)
+        self._sock_recv.start()
+        return True
+
+    def _recv_task(self):
+        try:
+            while self._receiving:
+                try:
+                    data = self._sock.recv(self.receive_bytes)
+                except socket.timeout:
+                    self.socket_timeouts += 1
+                    continue
+                except OSError as exc:
+                    if not self._closed:
+                        self.error = str(exc)
+                    break
+                if not data:
+                    if not self._closed:
+                        self.error = 'video_tcp_eof'
+                    break
+                received_at = time.monotonic()
+                if self.last_receive_at is not None:
+                    self.max_receive_gap_s = max(self.max_receive_gap_s, received_at-self.last_receive_at)
+                self.last_receive_at = received_at
+                self.chunks += 1
+                self.bytes += len(data)
+                chunk = VideoChunk(data, self.clock_ns(), received_at)
+                # Never call full/get/drop on compressed TCP fragments. Waiting
+                # slows socket reads and lets TCP apply its normal backpressure.
+                while self._receiving:
+                    try:
+                        self._sock_queue.put(chunk, timeout=.1)
+                        break
+                    except queue.Full:
+                        self.queue_waits += 1
+        finally:
+            self._receiving = False
+            self._signal_end()
+
+    def _signal_end(self):
+        while True:
+            try:
+                self._sock_queue.put(None, timeout=.1)
+                return
+            except queue.Full:
+                if self._closed:
+                    # Discarding bytes is permitted only after stream shutdown.
+                    try:
+                        self._sock_queue.get_nowait()
+                    except queue.Empty:
+                        pass
+
+    def disconnect(self):
+        self._closed = True
+        self._receiving = False
+        if self._sock is not None:
+            try:
+                self._sock.shutdown(socket.SHUT_RDWR)
+            except OSError:
+                pass
+            self._sock.close()
+        if self._sock_recv is not None:
+            self._sock_recv.join(timeout=1.)
+        else:
+            self._signal_end()
+
+
+def read_video_batch(chunks, max_chunks=8, timeout=.2):
+    """Read a bounded batch without losing bytes or chasing a growing queue forever."""
+    first = chunks.get(timeout=timeout)
+    if first is None:
+        return None
+    parts = [first.data]
+    stamp_ns, received_at = first.stamp_ns, first.received_at
+    for _ in range(max_chunks-1):
+        try:
+            chunk = chunks.get_nowait()
+        except queue.Empty:
+            break
+        if chunk is None:
+            # Preserve the terminal marker for the next read, after this data.
+            chunks.put_nowait(None)
+            break
+        parts.append(chunk.data)
+        stamp_ns, received_at = chunk.stamp_ns, chunk.received_at
+    return b''.join(parts), stamp_ns, received_at
+
+
+def put_latest(decoded_queue, message):
+    """Replace an old decoded frame, never H.264 data; return whether one was replaced."""
+    try:
+        decoded_queue.put_nowait(message)
+        return False
+    except queue.Full:
+        try:
+            decoded_queue.get_nowait()
+        except queue.Empty:
+            pass
+        decoded_queue.put_nowait(message)
+        return True
